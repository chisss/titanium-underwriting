<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.titanium</groupId>
    <artifactId>titanium-underwriting</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>titanium-underwriting</name>
    <description>Titanium Insurance Underwriting Service</description>

    <!-- Spring Boot 4.0.1 / Spring Cloud 2023.0.2 / Axon 4.10.0 / MapStruct 三件套 / fastjson2 / mysql / commons-lang3 / jjwt 均由 titanium-parent 统一管理 -->

    <dependencyManagement>
        <dependencies>
            <!-- 内部领域依赖（titanium-parent 未管理，需在此声明版本供子模块继承） -->
            <dependency>
                <groupId>com.titanium</groupId>
                <artifactId>titanium-common</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.titanium</groupId>
                <artifactId>titanium-metadata</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>titanium-underwriting-common</module>
        <module>titanium-underwriting-domain</module>
        <module>titanium-underwriting-infrastructure</module>
        <module>titanium-underwriting-application</module>
        <module>titanium-underwriting-api</module>
        <module>titanium-underwriting-web</module>
        <module>titanium-underwriting-bootstrap</module>
        <module>titanium-underwriting-query</module>
    </modules>

    <!-- 编译器三件套由 titanium-parent 提供；spring-boot-maven-plugin 仅在 bootstrap 启动模块激活 -->
    <build>
        <plugins>
            <!-- ========== 质量门禁激活（配置继承自 titanium-parent pluginManagement） ========== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>